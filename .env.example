# Copy to .env and adjust. See docs/PORTAL.md.
# REQUIRED in production: a long random value. It encrypts saved provider keys; if you lose or
# change it, stored keys can no longer be decrypted and users must re-enter them.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_SECRET_KEY=

# Set to true when served over HTTPS (behind a TLS-terminating proxy).
PORTAL_SECURE_COOKIES=false
PORTAL_ALLOW_SIGNUP=true

# Keep false for a hosted, multi-tenant portal: blocks user-supplied URLs that point at
# localhost, private networks or cloud metadata. Set true only for a single-team, self-hosted
# install that needs to test models on its own network (e.g. Ollama on localhost).
PORTAL_ALLOW_PRIVATE_URLS=false

PORTAL_WORKERS=2
PORTAL_MAX_ACTIVE_RUNS=3
PORTAL_MAX_UPLOAD_MB=25
PORTAL_MAX_LLM_CASES=200
PORTAL_MAX_LLM_OUTPUT_TOKENS=4096
PORTAL_SESSION_DAYS=14
